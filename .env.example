# Copy this file to .env.local and fill in real values.
# In Vercel, set the same variables under Settings → Environment Variables
# (Production AND Preview both — not just Production).

# Admin password for the /admin panel. Make this LONG and random.
# Example: openssl rand -hex 24
ADMIN_PASSWORD=

# Upstash Redis — REQUIRED. Without these, admin login refuses with a 500
# (we cannot persist sessions safely without a shared store).
# Create a free database at https://upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary signed uploads — required for the admin photo uploader.
# Find these in Cloudinary Console → Settings → API Keys. Keep the secret
# only in server environment variables; never use NEXT_PUBLIC_ for it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (email delivery) — required for contact form.
# Sign up at https://resend.com and copy your API key.
RESEND_API_KEY=

# Where contact / meeting / order emails are sent.
CONTACT_EMAIL=info@desuisse.com
